# Copy to .env and adjust before: docker compose up -d --build

# Required — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# App port published on the host
APP_PORT=3000

# PostgreSQL (used by docker-compose db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_management

# Optional
DEV_AUTO_LOGIN=false
OWNER_OPEN_ID=
OAUTH_SERVER_URL=
VITE_APP_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
